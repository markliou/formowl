# Tracked non-secret template for the root-origin Issue #56 UAT surface.
{
	email {$FORMOWL_ACME_EMAIL}
	admin off
}

{$FORMOWL_PUBLIC_HOST} {
	encode zstd gzip

	@issue56_uat_browser path / /auth/start /auth/callback /auth/logout /api/*
	handle @issue56_uat_browser {
		reverse_proxy 127.0.0.1:{$FORMOWL_ISSUE56_UAT_PUBLISH_PORT} {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@formowl_connected path /.well-known/* /oauth/* /mcp /healthz /readyz
	handle @formowl_connected {
		reverse_proxy 127.0.0.1:{$FORMOWL_CONNECTED_PUBLISH_PORT} {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	respond 404
}
